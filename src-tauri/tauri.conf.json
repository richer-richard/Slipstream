{
  "$schema": "https://raw.githubusercontent.com/nicedoc/tauri-conf/refs/heads/main/tauri.conf.schema.json",
  "productName": "Slipstream",
  "version": "0.1.0",
  "identifier": "com.slipstream.editor",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Slipstream",
        "width": 1200,
        "height": 800,
        "minWidth": 600,
        "minHeight": 400,
        "transparent": true,
        "decorations": true,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "app",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}
